# ---- Database (Postgres) ----
# Neon:      neon.tech > project > Connection string (pooled)
# Supabase:  Project Settings > Database > Connection pooling (port 6543)
# Local:     postgresql://postgres:postgres@localhost:5432/travelroach
DATABASE_URL=

# ---- Sessions ----
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://travelroach.com

# ---- Email (Brevo) ----
# brevo.com > SMTP & API > API Keys
# Leave blank in development: emails log to the console instead of sending.
BREVO_API_KEY=
EMAIL_FROM=noreply@travelroach.com
EMAIL_FROM_NAME=Travel Roach
ENQUIRY_BCC=ops@travelroach.com

# ---- Uploads ----
UPLOAD_DIR=./public/uploads
